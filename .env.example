DATABASE_URL=postgresql://classloom_runtime:classloom_runtime_dev@localhost:5433/classloom
DATABASE_MIGRATION_URL=postgresql://classloom:classloom_dev@localhost:5433/classloom
DATABASE_PROVISIONER_URL=postgresql://classloom:classloom_dev@localhost:5433/classloom
DATABASE_RUNTIME_PASSWORD=classloom_runtime_dev
API_PORT=4000
TRUSTED_PROXY_HOPS=0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1
AUTH_COOKIE_NAME=classloom_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_IDLE_TTL_SECONDS=43200
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_INVITATION_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_LOGIN_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_INVITATION_LIMIT=10
AUTH_INVITATION_WINDOW_SECONDS=900
AUTH_RESET_LIMIT=3
AUTH_RESET_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_KEY=classloom-local-rate-limit-key-only-for-development
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM=ClassLoom <no-reply@localhost>
